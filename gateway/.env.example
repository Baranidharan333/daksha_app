# Daksha gateway settings. Copy to .env (never commit .env) and fill in.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs the stored ticket/session hashes. Different on every robot.
SESSION_SECRET=CHANGE_ME_FIRST_RANDOM_VALUE

# Launch key(s) the app sends in X-App-Key. Comma-separate one key per device
# (laptop) so a lost device can be revoked by deleting its key.
APP_LAUNCH_KEY=CHANGE_ME_SECOND_RANDOM_VALUE

# Where `python3 app.py` listens (the systemd unit sets its own). Use 0.0.0.0
# on the robot so the app can reach it over the network.
HOST=127.0.0.1
PORT=8100

# The real web UI, moved to a port that only listens on localhost.
#   Dashboard robot (s1):  UPSTREAM_URL=http://127.0.0.1:8101  (gateway on :8100)
#   Navigation base:       UPSTREAM_URL=http://127.0.0.1:8001  (gateway on :8000)
UPSTREAM_URL=http://127.0.0.1:8101

# false while the robots are served over plain HTTP on the LAN; true behind HTTPS.
COOKIE_SECURE=false

# Host names the robot may be reached by ("*" accepts any, e.g. changing DHCP IPs).
ALLOWED_HOSTS=s1.local,localhost,127.0.0.1

# Lifetimes in seconds.
TICKET_TTL=60
SESSION_TTL=28800

# Cookies ignore ports: use a different name if two gateways share one host.
COOKIE_NAME=daksha_session
