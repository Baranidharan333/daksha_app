# Daksha gate settings for the robot web UI. Copy to .env (never commit .env).
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs the stored ticket/session hashes. Different on every robot.
SESSION_SECRET=sGhsFu3bav1D4qfH-vLMLjKchD702ZfgpHaOswfhn_DNaV7dLr7n2R3o3lBeBXMm

# Launch key(s) the Daksha app sends in X-App-Key. Comma-separate one key per
# device (laptop), so a lost device can be revoked by deleting its key. The app
# reads its key from ~/.config/daksha/app_key.
APP_LAUNCH_KEY=BDTrhcwO2MTH_JlhI6v-5KXQ6AiGgoymp3iJODGwC_GPR6UImCiA24zC83paF9UP

# Where `python3 main.py` listens. Use 0.0.0.0 on the robot so the app can
# reach it over the network.
HOST=0.0.0.0
PORT=8100

# false while the robot is served over plain HTTP on the LAN; true behind HTTPS.
COOKIE_SECURE=false

# Lifetimes in seconds.
TICKET_TTL=60
SESSION_TTL=28800

# Cookies ignore ports: use a different name per UI if two share one host.
COOKIE_NAME=daksha_session

# Path prefixes served without a session (comma-separated), e.g. a health check
# for monitoring. Leave empty to gate everything.
PUBLIC_PATHS=/health
